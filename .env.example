# --- Database (required for Admin Panel + APIs) ---
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/universal-being

# --- Site (used to build absolute canonical/OG/JSON-LD URLs — Step 7.6E) ---
# NEXT_PUBLIC_SITE_URL=https://universalbeing.in

# --- Auth (required) ---
# Any long random string. Generate with: openssl rand -base64 48
SESSION_SECRET=

# --- Dev-only admin auto-seed (instrumentation.ts) ---
# On `npm run dev`, if no admin user exists yet, one is created automatically
# with these credentials. Only active while NODE_ENV=development, and only
# runs if no admin account already exists. Set DISABLE_DEV_ADMIN_SEED=true
# to opt out entirely.
DEV_ADMIN_EMAIL=
DEV_ADMIN_PASSWORD=
DEV_ADMIN_NAME=
# DISABLE_DEV_ADMIN_SEED=true

# --- ImageKit (optional — enables direct media uploads; without these,
#     the Media Library falls back to "Add by URL") ---
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# --- Payments (Phase 8 — Book Your Slot via Razorpay) ---
# Server-side secret, used to create orders + verify payment signatures.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Same key id, exposed to the browser so the Razorpay Checkout widget can
# open. Safe to expose (it's not the secret) — required for the "Book Now"
# flow to open the payment sheet. Without these three set, bookings still
# work as timed seat reservations, just without an online checkout.
NEXT_PUBLIC_RAZORPAY_KEY_ID=

# --- Booking Expiry Timer (Phase 8) ---
# Minutes an unpaid "Book Your Slot" reservation holds a seat before it
# auto-expires and the seat is released. Change freely (10/15/20/30/...) —
# no code change needed. Defaults to 15 if unset.
BOOKING_RESERVATION_EXPIRY_MINUTES=15

# --- Cron (Phase 8) ---
# Shared secret required to hit /api/cron/expire-bookings, which sweeps and
# auto-expires overdue reservations. Point a scheduler (Vercel Cron / any
# external cron) at that URL every 1-5 minutes with this as a Bearer token
# or `?secret=` query param. Leave unset in local dev to allow unauthenticated
# calls for testing. Also gates /api/cron/send-reminders (Step 8C).
CRON_SECRET=

# --- Step 8C — Production Payment Ecosystem ---

# Razorpay Webhooks (Part 1). Configure this in the Razorpay Dashboard ->
# Webhooks, pointed at POST /api/payments/webhook, subscribed to:
# payment.captured, payment.failed, refund.processed, order.paid.
# This is a SEPARATE secret from RAZORPAY_KEY_SECRET above.
RAZORPAY_WEBHOOK_SECRET=

# Payment Retry (Part 3) — optional safety cap; unset = unlimited.
PAYMENT_MAX_RETRY_ATTEMPTS=
PAYMENT_RETRY_ORDER_EXPIRY_MINUTES=15

# Invoice Numbering (Part 7) — e.g. UB-2026-000001.
INVOICE_PREFIX=UB
INVOICE_SEQUENCE_PADDING=6
BUSINESS_GSTIN=
BUSINESS_LEGAL_NAME=Universal Being
BUSINESS_REGISTERED_ADDRESS=

# --- Invoice header/footer (optional — blank fields are simply omitted) ---
BUSINESS_PHONE=
BUSINESS_EMAIL=
BUSINESS_WEBSITE=
BUSINESS_UDYAM_NUMBER=
BUSINESS_MSME_UAN=
BUSINESS_SIGNATORY_NAME=
GST_RATE_PERCENT=0

# Refund policy (Part 6) — informational only, doesn't block admin action.
REFUND_POLICY_DAYS=7

# Email Notifications (Part 9) — without RESEND_API_KEY, emails are logged
# to the console instead of sent (dev-safe default). Once a key is set, the
# `from` address below MUST be on a domain verified for SENDING in the
# Resend dashboard (Domains -> your domain -> the SPF/DKIM rows show
# "Verified") or every send fails with a 403. "Enable Receiving" / the MX
# record for inbound mail is unrelated to this and can be left off — this
# app only ever sends, it never reads incoming mail.
RESEND_API_KEY=
NOTIFICATIONS_FROM_EMAIL=bookings@universalbeing.in
ADMIN_NOTIFICATION_EMAIL=

# WhatsApp Notifications (Part 10) — without these, WhatsApp messages are
# logged to the console instead of sent (dev-safe default).
WHATSAPP_CLOUD_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# --- Rate Limiting (Upstash Redis) ---
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

RATE_LIMIT_ENABLED=true

LOGIN_RATE_LIMIT=5,15 m
OTP_RATE_LIMIT=3,10 m
BOOKING_RATE_LIMIT=10,1 m
COUPON_RATE_LIMIT=10,1 m
CUSTOMER_LOGIN_RATE_LIMIT=5,15 m
CUSTOMER_SIGNUP_RATE_LIMIT=5,1 h
CUSTOMER_PASSWORD_RESET_RATE_LIMIT=3,30 m

RATE_LIMIT_IP_WHITELIST=
RATE_LIMIT_MOBILE_WHITELIST=

# --- Customer "Sign in with Google" (header login modal) ---
# Not required to use the site — email/password signup+login already works
# without these. Set both to turn on the Google button; see the comments
# in app/api/customer/auth/google/route.ts for the full setup steps.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- CRM: Meta Lead Ads (Phase 5) ---
# Webhook URL to register in Meta App Dashboard -> Webhooks -> Page /
# Instagram, subscribed to the "leadgen" field:
#   https://<your-domain>/api/webhooks/meta-leads
# META_VERIFY_TOKEN: any string you choose — enter the SAME value in the
# Meta dashboard's "Verify Token" field during webhook setup.
META_VERIFY_TOKEN=
# META_APP_SECRET: Meta App Dashboard -> Settings -> Basic -> App Secret.
# Used to verify the X-Hub-Signature-256 header on every webhook delivery.
META_APP_SECRET=
# META_PAGE_ACCESS_TOKEN: a Page access token with the `leads_retrieval`
# permission, used server-side to fetch each lead's answers from the
# Graph API after the webhook notifies us a new leadgen_id exists.
META_PAGE_ACCESS_TOKEN=
